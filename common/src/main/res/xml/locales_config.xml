<?xml version="1.0" encoding="utf-8"?>
<!-- CoFarmer supported languages -->
<!-- The system auto-detects device language and uses it if available -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>      <!-- English (default) -->
    <locale android:name="es"/>      <!-- Spanish / Español -->
    <locale android:name="fr"/>      <!-- French / Français -->
    <locale android:name="de"/>      <!-- German / Deutsch -->
    <locale android:name="pt"/>      <!-- Portuguese / Português -->
    <locale android:name="ar"/>      <!-- Arabic / العربية -->
    <locale android:name="zh"/>      <!-- Chinese / 中文 -->
    <locale android:name="hi"/>      <!-- Hindi / हिन्दी -->
    <locale android:name="ko"/>      <!-- Korean / 한국어 -->
    <locale android:name="ja"/>      <!-- Japanese / 日本語 -->
</locale-config>
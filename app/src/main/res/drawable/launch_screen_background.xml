<?xml version="1.0" encoding="utf-8"?>
<!-- CoFarmer Assistant launch window (API < 26, and night mode on all APIs).
     Uses a PNG logo: gradient VectorDrawables are not supported before API 24.
     The wordmark and tagline are drawn by BrandingSplashScreen (Compose). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/colorLaunchScreenBackground" />

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0000C389"
                android:centerColor="#0000C389"
                android:endColor="#1500C389"
                android:centerY="0.9" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:top="-60dp"
        android:width="140dp"
        android:height="140dp"
        android:drawable="@drawable/splash_logo_cofarmer_png" />

    <item
        android:gravity="center_horizontal|bottom"
        android:bottom="48dp"
        android:width="100dp"
        android:height="24dp"
        android:drawable="@drawable/splash_by_enkitek" />
</layer-list>
